@model IEnumerable<EmployeeDirectory.Models.Employee>

@{
    ViewData["Title"] = "Employee Directory";
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Employee Directory</h2>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Dashboard">Dashboard Home</a>
        }
        <a class="btn btn-primary" asp-action="Create">New Employee</a>
    </div>
</div>

<div class="row">
    @foreach (var emp in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <img src="@(emp.PhotoUrl ?? "/images/placeholder.png")" class="card-img-top" alt="Profile photo">
                <div class="card-body">
                    <h5 class="card-title">@emp.FullName</h5>
                    <p class="card-text">@emp.JobTitle</p>
                    <p class="card-text"><small class="text-muted">@emp.Department?.Name</small></p>
                    <p class="card-text"><a href="mailto:@emp.Email">@emp.Email</a></p>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@emp.EmployeeId">View</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@emp.EmployeeId">Edit</a>
                </div>
            </div>
        </div>
    }
</div>
