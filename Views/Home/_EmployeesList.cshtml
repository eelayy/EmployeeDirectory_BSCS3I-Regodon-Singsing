@model IEnumerable<EmployeeDirectory.Models.Employee>
<div class="mb-3 d-flex justify-content-between align-items-center">
    <h3 class="h5 mb-0">All Employees <small class="text-muted">(@Model.Count())</small></h3>
</div>
<div class="row g-3">
@foreach(var e in Model){
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@e.FirstName @e.LastName</h5>
                <p class="card-text mb-1">@e.JobTitle</p>
                <p class="text-muted small mb-0">@(e.Department != null ? e.Department.Name : "No department")</p>
            </div>
        </div>
    </div>
}
</div>
