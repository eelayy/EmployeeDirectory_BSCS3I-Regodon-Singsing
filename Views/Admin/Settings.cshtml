@model IDictionary<string,string?>
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Settings</li>
        </ol>
    </nav>
}

<div class="card">
    <div class="card-body">
        <form asp-action="SaveSettings" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Recent activity count</label>
                <input name="recentActivityCount" value="@Model["Dashboard:RecentActivityCount"]" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Chart months back</label>
                <input name="chartMonthsBack" value="@Model["Dashboard:ChartMonthsBack"]" class="form-control" />
            </div>
            <button class="btn btn-primary">Save Settings</button>
        </form>
    </div>
</div>
