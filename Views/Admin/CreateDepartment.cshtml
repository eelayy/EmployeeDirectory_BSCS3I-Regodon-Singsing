@model EmployeeDirectory.Models.Department
@{
    ViewData["Title"] = "Create Department";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Departments">Departments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create</li>
        </ol>
    </nav>
}

<div class="card">
    <div class="card-body">
        <form asp-action="CreateDepartment" method="post">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <button class="btn btn-primary">Create</button>
            <a asp-action="Departments" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
